{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratogroup.ai/schemas/integration-release-manifest.schema.json",
  "title": "Integration Release Manifest",
  "type": "object",
  "required": ["schemaVersion", "producer", "releaseTag", "commitSha", "publishedAt", "artifacts"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/v\\d+\\.\\d+\\.\\d+$"
    },
    "commitSha": {
      "type": "string",
      "minLength": 7
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifactId", "kind", "version", "assetName", "checksumSha256", "sourcePath"],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "assetName": {
            "type": "string",
            "minLength": 1
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
