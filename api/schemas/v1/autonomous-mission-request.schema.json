{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aico.example/v1/autonomous-mission-request.schema.json",
  "title": "Autonomous Mission Request",
  "type": "object",
  "required": ["schemaVersion", "missionId", "tenant", "repository", "objective", "constraints", "requestedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "missionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "tenant": {"$ref": "tenant-context.schema.json"},
    "repository": {
      "type": "object",
      "required": ["owner", "name", "revision"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      },
      "additionalProperties": false
    },
    "objective": {"type": "string", "minLength": 10, "maxLength": 10000},
    "constraints": {
      "type": "object",
      "required": ["allowedPaths", "deniedPaths", "maxRuntimeSeconds", "requiresHumanApproval"],
      "properties": {
        "allowedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "deniedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "maxRuntimeSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "requiresHumanApproval": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "requestedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
