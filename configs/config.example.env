NF_HTTP_ADDR=:8080
NF_GRPC_ADDR=:9090
NF_WORKER_ADDR=:8081
NF_MOCK_HTTP_ADDR=:8090
NF_SERVICE_NAME=neuroforge-sdx
NF_ENVIRONMENT=local
NF_LOG_LEVEL=INFO
NF_SHUTDOWN_TIMEOUT=15s
NF_NATS_URL=nats://localhost:4222
NF_NATS_SUBJECT=neuroforge.sdx.events
NF_NATS_STREAM=neuroforge-sdx-events
NF_OTEL_EXPORTER_OTLP_ENDPOINT=
NF_YUGABYTE_DSN=postgres://postgres:postgres@localhost:5433/neuroforge?sslmode=disable
NF_DRAGONFLY_ADDR=localhost:6379
NF_QDRANT_URL=http://localhost:6333
NF_ARTIFACT_BASE_URL=https://artifacts.neuroforge.local
NF_ARTIFACT_SIGNING_KEY=neuroforge-sdx-local-signing-key
NF_ARTIFACT_URL_TTL=15m
NF_ALLOW_ANONYMOUS=false
